# Mercado Pago (Checkout Bricks), conta oficial do Goiás FA
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Banco de dados (Supabase)
# DATABASE_URL: connection pooling (porta 6543, com "?pgbouncer=true"), usada em runtime.
# DIRECT_URL: direct connection (porta 5432), usada só pelo `prisma migrate`.
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://usuario:senha@host:5432/postgres

# Cloudflare R2 (armazenamento de imagens dos produtos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Resend (e-mails transacionais)
RESEND_API_KEY=
EMAIL_FROM=contato@goiasfa.com.br

# App
NEXT_PUBLIC_SITE_URL=https://goiasfa.com.br

# Painel administrativo
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Melhor Envio (cálculo de frete)
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true
CEP_ORIGEM=
